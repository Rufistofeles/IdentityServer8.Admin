@using Microsoft.AspNetCore.Mvc.Localization
@using IdentityServer8.STS.Identity.Configuration.Interfaces
@using IdentityServer8.STS.Identity.Helpers.Localization
@inject IViewLocalizer Localizer
@model IdentityServer8.STS.Identity.ViewModels.Account.LoginViewModel
@inject IRootConfiguration RootConfiguration
@{
	Layout = null;
}



<!doctype html>
<html lang="en" data-layout="vertical" data-layout-style="detached" data-sidebar="light" data-topbar="dark" data-sidebar-size="lg">
<head>
	@await Html.PartialAsync("~/Views/Shared/_title_meta.cshtml")
	@await Html.PartialAsync("~/Views/Shared/_head_css.cshtml")

	<style>
		body, html {
			height: 100%;
		}

		.bg {
			/* The image used */
			background-image: url('@Url.Content("~/assets/images/logos/WeAreOrbia.png")');
			/* Full height */
			height: 100%;
			/* Center and scale the image nicely */
			background-position: center;
			background-repeat: no-repeat;
			background-size: cover;
		}
	</style>
</head>

<body class="bg">

	<div class="auth-page-wrapper pt-5">
		<!-- auth page bg -->
		@*<div class="auth-one-bg-position auth-one-bg"  id="auth-particles">
				<div class="bg-overlay"></div>
				
				<div class="shape">
					<svg xmlns="http://www.w3.org/2000/svg" version="1.1" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 1440 120">
						<path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
					</svg>
				</div>
			</div>*@

		@*<div>
				<img src="~/assets/images/logos/WeAreOrbia.png" alt="">
			</div>*@

		<!-- auth page content -->
		<div class="auth-page-content">
			<div class="container">
				<div class="row">
					<div class="col-lg-12">
						<div class="text-center mt-sm-5 mb-4 text-white-50">
							<div>
								<a href="#" class="d-inline-block auth-logo">
									<img src="~/assets/images/logos/Orbia_White.png" alt="" height="110">
								</a>
							</div>
							<p class="mt-3 fs-15 fw-medium"></p>
						</div>
					</div>
				</div>
				<!-- end row -->

				<div class="row justify-content-center">
					<div class="col-md-8 col-lg-6 col-xl-5">
						<div class="card mt-4">

							<div class="card-body p-4">
								<div class="text-center mt-2">
									@* <h5 class="text-primary">Atlas PMV</h5> *@
									<h5 class="text-primary">@Model.Company</h5>
									<p class="text-muted">Inicia sesión para entrar al sistema.</p>
								</div>
								<div class="p-2 mt-4">
									<form asp-route="Login">
										@* 
											<div class="mb-3">
												<label for="Username" asp-for="Username" class="form-label">Usuario</label>
												<input asp-for="Username" type="text" class="form-control" placeholder="Usuario">
											</div>
					
											<div class="mb-3">
												<div class="float-end">
													<a asp-controller="Account" asp-action="ForgotPassword" class="text-muted">¿Olvidó su contraseña?</a>
												</div>
												<label for="Password" class="form-label" asp-for="Password">Contraseña</label>
												  <div class="position-relative auth-pass-inputgroup mb-3">
													<input asp-for="Password" type="password" class="form-control pe-5 password-input" placeholder="Contraseña" id="password-input">
													<button class="btn btn-link position-absolute end-0 top-0 text-decoration-none text-muted password-addon" type="button" id="password-addon"><i class="ri-eye-fill align-middle"></i></button>
												</div>
											</div>

											<div class="form-check">
												<input class="form-check-input" type="checkbox" value="" id="user-checkbox">
												<label class="form-check-label" for="user-checkbox">Recordarme</label>
											</div>

											<div class="mt-4">
												<button class="btn btn-info w-100" value="login" name="button" type="submit">Iniciar Sesión</button>
											</div> *@

										@if (Model.VisibleExternalProviders.Any())
										{
											<div class="mt-4 text-center">
												<div class="signin-other-title">
													@* <h5 class="fs-13 mb-4 title">Inicia sesión con:</h5> *@
												</div>
												<div>
													<ul class="list-inline">
														@foreach (var provider in Model.VisibleExternalProviders)
														{
															var msAccount = "Orbia SSO";
															<li class="list-inline-item">
																<a class="btn btn-secondary"
																   asp-action="ExternalLogin"
																   asp-controller="Account"
																   asp-route-provider="@provider.AuthenticationScheme"
																   asp-route-returnUrl="@Model.ReturnUrl">
																	@if (provider.DisplayName == "Saml2")
																	{
																		<span>
																			<i class="mdi mdi-microsoft"></i>
																			@msAccount
																		</span>
																	}
																	else
																	{
																		@provider.DisplayName
																	}

																</a>
															</li>
														}
													</ul>

												</div>
											</div>
										}


									</form>
								</div>
							</div>
							<!-- end card body -->
						</div>
						<!-- end card -->
						@*<div class="mt-4 text-center">
								<p class="mb-0">Don't have an account ? <a href="@Url.Action("SignUpBasic", "Authentication")" class="fw-semibold text-primary text-decoration-underline"> Signup </a> </p>
							</div>*@

					</div>
				</div>
				<!-- end row -->
			</div>
			<!-- end container -->
		</div>
		<!-- end auth page content -->
		<!-- footer -->
		<footer class="footer">
			<div class="container">
				<div class="row">
					<div class="col-lg-12">
						<div class="text-center">
							<p class="mb-0">&copy; <script>document.write(new Date().getFullYear())</script> Orbia. Crafted with <i class="mdi mdi-heart text-danger"></i> by DOMO</p>
						</div>
					</div>
				</div>
			</div>
		</footer>
		<!-- end Footer -->
	</div>
	<!-- end auth-page-wrapper -->
	@await Html.PartialAsync("~/Views/Shared/_vendor_scripts.cshtml")

	@await Html.PartialAsync("~/Views/Shared/_notificationPartial.cshtml")




	@*<!-- particles js -->
	<script src="~/assets/libs/particles.js/particles.js"></script>
	<!-- particles app js -->
	<script src="~/assets/js/pages/particles.app.js"></script>*@
	<!-- password-addon init -->
	<script src="~/assets/js/pages/password-addon.init.js"></script>



</body>
</html>







